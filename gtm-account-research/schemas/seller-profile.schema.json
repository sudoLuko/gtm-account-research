{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seller-profile.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "timestamp"
    },
    "seller": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "public-url"
            },
            {
              "type": "null"
            }
          ]
        },
        "product_scope": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "website",
        "product_scope",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "seller_confirmed",
              "source_reported",
              "inferred"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "availability": {
            "enum": [
              "supported",
              "preview",
              "planned",
              "unknown",
              "not_applicable"
            ]
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "basis",
          "source_ids",
          "availability",
          "scope",
          "evidence_note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "seller_confirmed",
              "source_reported",
              "inferred"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "availability": {
            "enum": [
              "supported",
              "preview",
              "planned",
              "unknown",
              "not_applicable"
            ]
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "basis",
          "source_ids",
          "availability",
          "scope",
          "evidence_note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "customer_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "seller_confirmed",
              "source_reported",
              "inferred"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "availability": {
            "enum": [
              "supported",
              "preview",
              "planned",
              "unknown",
              "not_applicable"
            ]
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "basis",
          "source_ids",
          "availability",
          "scope",
          "evidence_note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "fit_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "basis_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "observable_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "counter_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "condition",
          "rationale",
          "basis_claim_ids",
          "observable_signals",
          "counter_signals"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "exclusion_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "basis_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 1
          },
          "observable_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "counter_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "condition",
          "rationale",
          "basis_claim_ids",
          "observable_signals",
          "counter_signals"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "conversation",
              "file",
              "web"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "published_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "partial-date"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "reference",
          "published_on",
          "retrieved_at",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "research_impact": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "missing",
              "conflict"
            ]
          },
          "related_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "blocks_research": {
            "type": "boolean"
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "research_impact",
          "kind",
          "related_claim_ids",
          "blocks_research",
          "next_action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "readiness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ready",
            "ready_with_limits",
            "needs_input"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "blocking_gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "reason",
        "blocking_gap_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "reviewed_at",
    "seller",
    "capabilities",
    "limits",
    "customer_workflows",
    "fit_hypotheses",
    "exclusion_hypotheses",
    "sources",
    "unknowns",
    "readiness"
  ],
  "additionalProperties": false
}
