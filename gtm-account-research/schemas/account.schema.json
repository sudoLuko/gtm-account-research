{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "account.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "2.0"
      ]
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "research_as_of": {
      "type": "string",
      "format": "date"
    },
    "research_timezone": {
      "type": "string",
      "minLength": 1
    },
    "seller_profile": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile_id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "prospect": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "domain"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "reported",
              "inferred",
              "unresolved"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "conflicting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "limits": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "evidence_ids",
          "conflicting_evidence_ids",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "step_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          },
          "connection_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "scope",
          "step_claim_ids",
          "connection_claim_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assessment": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": [
            "consider",
            "reserve",
            "deprioritize",
            "insufficient_evidence"
          ]
        },
        "rationale_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 0
        },
        "limits": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "disposition",
        "rationale_claim_ids",
        "limits"
      ],
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question_id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "account_id",
    "research_as_of",
    "research_timezone",
    "seller_profile",
    "prospect",
    "claims",
    "workflows",
    "assessment",
    "unknowns"
  ],
  "additionalProperties": false
}
